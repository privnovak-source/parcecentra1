{
     "version": 2,
     "builds": [
       {
         "src": "app/api/boot.ts",
         "use": "@vercel/node"
       },
       {
         "src": "app/dist/**",
         "use": "@vercel/static"
       }
     ],
     "routes": [
       {
         "src": "/api/(.*)",
         "dest": "app/api/boot.ts"
       },
       {
         "src": "/(.*)",
         "dest": "app/dist/$1"
       }
     ]
   }